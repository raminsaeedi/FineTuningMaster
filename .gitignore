# ── Secrets ──────────────────────────────────────────────────
.env

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Data ─────────────────────────────────────────────────────
# Processed splits are regeneratable via `python scripts/build_data.py`.
data/processed/
data/index/
# RAG chunks are regeneratable via `python scripts/build_kb.py` (guidelines/ stays tracked).
data/knowledge_base/chunks.jsonl
data/knowledge_base/index/

# ── Staging candidate datasets (pre-freeze, regeneratable) ──────
# Versioned staging builds (e.g. nvBench pilots) are reproducible from the
# builder + registered source; not versioned in Git.
data/staging/

# ── Rebuildable external caches (regeneratable from raw archives) ──
# Extracted database caches are large and reproducible via
# `python experiments/scripts/prepare_nvbench_cache.py`; never versioned.
data/cache_external/

# ── External raw datasets (large, user-provisioned, immutable) ──
# Ignore all raw archives and extracted external files, but keep the small
# registration manifests, checksum listings and docs trackable. Directories are
# re-included first so git can descend to the whitelisted files inside them.
/data/raw_external/**
!/data/raw_external/**/
!/data/raw_external/**/source_manifest.json
!/data/raw_external/**/SHA256SUMS.txt
!/data/raw_external/**/source_inspection_report.json
!/data/raw_external/**/*.md

# ── Experiment outputs & model weights (large; not versioned) ─
# NOTE: ignore any 'models/' weights directory, but keep the source package
# src/models/ (the import-safe HF wrapper) tracked — the negation re-includes it.
outputs/
models/
!src/models/

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Claude worktrees (AI-generated temporary workspaces) ─────
.claude/
.agents/

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
skills-lock.json
