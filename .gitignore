# ── Secrets ──────────────────────────────────────────────────
.env
.env.*
!.env.example
# Per-machine path settings (paths.env.example is the tracked template).
paths.env
!paths.env.example
*.token
hf_token*
.huggingface/

# ── Python environments (Poetry keeps the project env in ./.venv) ──
.venv/
venv/
.poetry/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Data ─────────────────────────────────────────────────────
# Processed splits are regeneratable via `python scripts/build_data.py`.
data/processed/
data/index/
# RAG chunks are regeneratable via `python experiments/scripts/build_kb.py`
# (guidelines/ and kb_manifest.json stay tracked, so a rebuild can be verified).
data/knowledge_base/chunks.jsonl
data/knowledge_base/index/

# ── Staging candidate datasets (pre-freeze, regeneratable) ──────
# Versioned staging builds (e.g. nvBench pilots) are reproducible from the
# builder + registered source; not versioned in Git.
data/staging/

# ── Rebuildable external caches (regeneratable from raw archives) ──
# Extracted database caches are large and reproducible via
# `python experiments/scripts/prepare_nvbench_cache.py`; never versioned.
data/cache_external/
data/Data from HPC/

# ── External raw datasets (large, user-provisioned, immutable) ──
# Ignore all raw archives and extracted external files, but keep the small
# registration manifests, checksum listings and docs trackable. Directories are
# re-included first so git can descend to the whitelisted files inside them.
/data/raw_external/**
!/data/raw_external/**/
!/data/raw_external/**/source_manifest.json
!/data/raw_external/**/SHA256SUMS.txt
!/data/raw_external/**/source_inspection_report.json
!/data/raw_external/**/*.md

# ── Experiment outputs & model weights (large; not versioned) ─
# NOTE: ignore any 'models/' weights directory, but keep the source package
# src/models/ (the import-safe HF wrapper) tracked — the negation re-includes it.
outputs/
models/
!src/models/

# Raw run artifacts (predictions, adapters, checkpoints) are large and stay out
# of Git; configurations, scripts, and reports remain trackable.
experiments/outputs/
# Everything under experiments/results/ is ignored by default. Directories are
# re-included first so Git can descend into them, and the consolidated result
# tables, figures and statistics under experiments/results/final/ are then
# re-included explicitly: the thesis chapters cite those files as evidence and
# they are only a few MB in total.
experiments/results/**
!experiments/results/**/
!experiments/results/final/**
# Human-evaluation studies contain private rater links and unblinding keys.
# Keep the complete study tree local and out of the thesis repository.
experiments/results/human_eval/
# The hand-off packages are zipped duplicates of the tables above; keep them out.
experiments/results/packages/**
# Large local result archives that are not part of the repository.
experiments/*.zip
# Generated SLURM job scripts, task lists and job logs.
experiments/slurm/jobs/
slurm-*.out
slurm-*.err

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Claude worktrees (AI-generated temporary workspaces) ─────
.claude/
.agents/

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
skills-lock.json
codex.md
.codesight/
graphify-out/

# ── Generated result packages (produced on the GPU machine) ──
professor_results*.zip
professor_results*_manifest.json
