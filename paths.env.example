# MASTER PATH CONFIG for ./run_experiment.sh
#
# Setup on a new machine:
#     cp paths.env.example paths.env
#     nano paths.env          # set BIG to a volume with free space
#     ./run_experiment.sh ...  # picks paths.env up automatically
#
# paths.env is git-ignored, so every machine keeps its own.
# Absolute paths. Everything below is optional; unset = repo/home defaults.
#
# WITHOUT this file: model weights go to ~/.cache/huggingface (~65 GB for the
# four final models) and adapters + trainer checkpoints go into
# experiments/outputs/ inside the repository.

# One volume with free space. Everything else hangs off it.
BIG=/mnt/big

VENV_PATH=$BIG/venv                   # the Python environment (default: ./.venv)
HF_HOME=$BIG/hf                       # downloaded base model weights
CACHE_PATH=$BIG/hf-cache              # model.cache_dir for training + inference
OUTPUT_DATA_PATH=$BIG/runs            # predictions, metrics, manifests, logs
OUTPUT_MODEL_PATH=$BIG/adapters       # adapters AND trainer checkpoints (large)
RESULTS_PATH=$BIG/results             # aggregated CSV / Markdown tables

# --- optional -------------------------------------------------------------
# DATASET=dashboard_v4
# PROFILE=final
# PYTHON_BIN=python
# DATA_PATH=data/frozen/dashboard_v4          # where the dataset is read from
# KB_CHUNKS_PATH=data/knowledge_base/chunks.jsonl
# BASE_MODEL_PATH=/mnt/big/models/qwen3-8b   # pre-downloaded weights, no HF download
# Shrink checkpoint disk usage:
# EXTRA_OVERRIDES_STR="training.sft.save_total_limit=1 training.sft.save_steps=200"

# Keep HF_TOKEN out of this file — export it in the shell session.
