# ── HuggingFace ──────────────────────────────────────────────
# Token for downloading gated models (e.g. Llama, Mistral).
# Not required for Qwen models, but recommended to avoid rate limits.
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Phase-3 enrichment provider (OpenAI-compatible gateway) ──
# THIS FILE IS TRACKED BY GIT — every value below must stay a placeholder.
# Real keys go into `.env` (git-ignored) or into the shell session only:
#   $env:ENRICHMENT_API_KEY="<key>"
# See docs/project/ENRICHMENT_PROVIDER_SETUP.md
ENRICHMENT_BASE_URL=https://adesso-ai-hub.3asabc.de/v1
ENRICHMENT_API_KEY=
ENRICHMENT_MODEL=deepseek-v4-flash-sovereign
ENRICHMENT_REASONING_EFFORT=xhigh

# ── Model cache (optional) ───────────────────────────────────
# Override where HuggingFace stores downloaded model weights.
# Default: ~/.cache/huggingface/hub
# TRANSFORMERS_CACHE=/path/to/model/cache

# ── CUDA / GPU (optional) ────────────────────────────────────
# Limit visible GPUs if running on a multi-GPU machine.
# CUDA_VISIBLE_DEVICES=0
